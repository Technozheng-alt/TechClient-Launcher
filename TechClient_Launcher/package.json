{
  "name": "myclient-launcher",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.myclient.launcher",
    "productName": "MyClient Launcher",
    "mac": {
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis"
    }
  }
}